{
    "name": "webauditkit/webauditkit",
    "description": "Open-source website auditing toolkit for technical SEO and on-page analysis.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "seo",
        "seo-audit",
        "website-audit",
        "technical-seo",
        "web-audit"
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "WebAuditKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebAuditKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests"
    }
}
